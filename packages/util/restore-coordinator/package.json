{
  "name": "@deepseek-ai/dsh-restore-coordinator",
  "description": "Transactional restore-wizard orchestration over the session-backup primitives: impact preview (diff current vs snapshot), verified restore with pre-restore rollback, and post-restore byte verification",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/util/restore-coordinator"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-session-backup": "workspace:^"
  },
  "license": "MIT"
}